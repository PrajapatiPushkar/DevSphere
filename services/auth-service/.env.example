# DevSphere Auth Service Local Environment Variables
# Copy to .env for local overrides (never commit real secrets)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=devsphere_auth
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Configuration (Secret MUST be at least 32 characters / 256 bits long for HS256)
JWT_SECRET=replace-with-a-secure-secret-key-that-is-at-least-256-bits-long
JWT_EXPIRATION_SECONDS=3600
